# --- Anthropic (leave empty to run the offline StubReasoner) ---
ANTHROPIC_API_KEY=
# Pinned production model id (never an alias)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
COMPUTER_USE_TOOL_VERSION=computer_20250124
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1024

# --- Sandbox / VM ---
# fake (tests) | playwright (headless Chromium over sandbox/webapps) | xdotool (Xvfb desktop)
VM_MODE=playwright
CHROMIUM_PATH=/opt/pw-browsers/chromium
DISPLAY_WIDTH=1024
DISPLAY_HEIGHT=768
SCREENSHOT_DIR=data/screenshots
MAX_STEPS_PER_TASK=30
VM_VNC_HOST=sandbox
VM_VNC_PORT=5900

# --- Audit log (PostgreSQL when set, SQLite otherwise) ---
DATABASE_URL=
AUDIT_SQLITE_PATH=data/audit.sqlite3

# --- API hardening ---
CORS_ORIGINS=http://localhost:3000,https://juadsuarezsan.github.io
RATE_LIMIT=10/minute

# --- Observability (LangSmith) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=computer-use-agent
