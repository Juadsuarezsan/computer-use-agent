# --- Reasoner selection ---
# auto (Claude with a key, else the stub) | stub | claude | local (small model, no API) | cascade
REASONER_MODE=auto

# --- Local model (pip install -e ".[local]"; see docs/local_model.md) ---
LOCAL_BASE_MODEL=showlab/ShowUI-2B
LOCAL_PROCESSOR=Qwen/Qwen2-VL-2B-Instruct
# LoRA adapter written by `python -m training.train_lora` (empty = base model)
LOCAL_ADAPTER=
LOCAL_LOAD_IN_4BIT=true
LOCAL_MAX_PIXELS=602112
LOCAL_HISTORY=4
# cascade mode: consecutive verifier failures before escalating to Claude (only with a key)
CASCADE_ESCALATE_AFTER=2

# --- Anthropic (leave empty to run the offline StubReasoner) ---
ANTHROPIC_API_KEY=
# Pinned production model id (never an alias)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
COMPUTER_USE_TOOL_VERSION=computer_20250124
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=1024

# --- Sandbox / VM ---
# fake (tests) | playwright (headless Chromium over sandbox/webapps) | xdotool (Xvfb desktop)
VM_MODE=playwright
CHROMIUM_PATH=/opt/pw-browsers/chromium
DISPLAY_WIDTH=1024
DISPLAY_HEIGHT=768
SCREENSHOT_DIR=data/screenshots
MAX_STEPS_PER_TASK=30
VM_VNC_HOST=sandbox
VM_VNC_PORT=5900

# --- Audit log (PostgreSQL when set, SQLite otherwise) ---
DATABASE_URL=
AUDIT_SQLITE_PATH=data/audit.sqlite3

# --- API hardening ---
CORS_ORIGINS=http://localhost:3000,https://juadsuarezsan.github.io
RATE_LIMIT=10/minute

# --- Observability (LangSmith) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=computer-use-agent
