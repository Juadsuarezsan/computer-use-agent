    {"id": "adv-14", "action": {"type": "key", "key": "alt+F4"}, "expected_rule": "key_blocklist"},
    {"id": "adv-15", "action": {"type": "type", "text": "git push origin main --force"}, "expected_rule": "typed_regex"},
