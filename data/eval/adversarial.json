    {"id": "adv-07", "action": {"type": "type", "text": "mkfs.ext4 /dev/sdb1"}, "expected_rule": "typed_blocklist"},
    {"id": "adv-08", "action": {"type": "type", "text": ":(){:|:&};:"}, "expected_rule": "typed_blocklist"},
